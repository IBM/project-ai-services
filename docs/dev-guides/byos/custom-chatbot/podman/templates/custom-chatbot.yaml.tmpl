apiVersion: v1
kind: Pod
metadata:
  name: "custom-chatbot-{{ .InstanceSlug }}"
  labels:
    ai-services.io/template: "{{ .TemplateID }}"
  annotations:
    ai-services.io/routes: "8080:custom-chatbot-{{ .InstanceSlug }}:ui,8080:custom-chatbot-{{ .InstanceSlug }}:api"
spec:
  restartPolicy: always
  containers:
    - name: custom-chatbot
      image: "{{ .Values.chatbot.image }}"
      command:
        - "/bin/sh"
        - "-c"
      args:
        - |
          {{- if .Values.llm.apiKey }}
          export LLM_API_KEY=$(cat /etc/secret/vllm-secret/apiKey)
          {{- end }}
          exec /var/venv/bin/python -m uvicorn app:app \
            --host 0.0.0.0 \
            --port 8080 \
            --loop uvloop \
            --http httptools
      env:
        - name: PORT
          value: "8080"
        - name: LLM_ENDPOINT
          value: "http://{{ .Values.llm.host }}:{{ .Values.llm.port }}"
        - name: LLM_MODEL
          value: "{{ .Values.llm.model }}"
        - name: LLM_MAX_TOKENS
          value: "{{ .Values.chatbot.max_tokens }}"
        - name: LOG_LEVEL
          value: "{{ .Values.chatbot.log_level }}"
        {{- if .Values.chatbot.system_prompt }}
        - name: SYSTEM_PROMPT
          value: "{{ .Values.chatbot.system_prompt }}"
        {{- end }}
      resources:
        requests:
          memory: "256Mi"
        limits:
          memory: "512Mi"
      ports:
        - containerPort: 8080
          protocol: TCP
      livenessProbe:
        httpGet:
          path: /health
          port: 8080
        initialDelaySeconds: 10
        periodSeconds: 30
        timeoutSeconds: 5
        failureThreshold: 3
      readinessProbe:
        httpGet:
          path: /health
          port: 8080
        initialDelaySeconds: 5
        periodSeconds: 10
        timeoutSeconds: 3
        failureThreshold: 3
      {{- if .Values.llm.apiKey }}
      volumeMounts:
        - mountPath: /etc/secret/vllm-secret
          name: vllm-secret
          readOnly: true
      {{- end }}
  {{- if .Values.llm.apiKey }}
  volumes:
    - name: vllm-secret
      secret:
        secretName: "vllm-secret-{{ .Values.llm.instanceSlug }}"
  {{- end }}
