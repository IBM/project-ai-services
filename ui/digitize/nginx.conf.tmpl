worker_processes auto;

error_log  /var/log/nginx/error.log warn;
pid        /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    sendfile on;
    keepalive_timeout 65;

    server {
        listen 4001;

        add_header Content-Security-Policy "frame-ancestors 'none';" always;
        add_header X-Frame-Options "DENY" always;

        location / {
            root /usr/share/nginx/html;
            index index.html;
            try_files $uri /index.html;
        }

        # Runtime config for the SPA: where the catalog UI (sign-in page) lives. Empty means the
        # SPA infers it from its own host name.
        location = /config.json {
            default_type application/json;
            add_header Cache-Control "no-store" always;
            return 200 '{"catalogUiUrl":"${CATALOG_UI_URL}"}';
        }

        location = /auth/exchange {
            proxy_pass ${CATALOG_API_URL}/api/v1/auth/code/exchange;
            proxy_set_header Host $proxy_host;
            proxy_ssl_server_name on;
            proxy_ssl_verify on;
            proxy_ssl_trusted_certificate ${AUTH_CATALOG_CA_BUNDLE};
        }

        location /v1/ {
            client_max_body_size 1G;
            proxy_request_buffering off;

            proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
            proxy_set_header Host $host;
        }
    }
}
