# build stage
FROM registry.access.redhat.com/ubi9/nodejs-22 AS build

USER 1001
WORKDIR /app
COPY --chown=1001:0 package.json package-lock.json ./
RUN npm ci

COPY --chown=1001:0 . .
RUN npm run build


# runtime stage
FROM registry.access.redhat.com/ubi9/nginx-126:9.8

# Image provenance labels (populated via --build-arg, see hack/image-labels.mk)
ARG GIT_REPO=https://github.com/ibm/project-ai-services
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown
LABEL org.opencontainers.image.source="${GIT_REPO}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.title="Catalog UI" \
      org.opencontainers.image.vendor="IBM" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.description="Catalog UI for AI Services" \
      com.github.project-ai-services.containerfile="ui/catalog/Containerfile" \
      com.github.project-ai-services.containerfile.url="${GIT_REPO}/blob/${GIT_COMMIT}/ui/catalog/Containerfile"

USER root
RUN dnf update -y --disablerepo='*' --enablerepo='ubi-9-*' && dnf clean all
USER 1001

COPY nginx.conf.tmpl /etc/nginx/nginx.conf.tmpl
COPY --chmod=755 entrypoint.sh /entrypoint.sh

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8081

CMD ["/bin/bash", "/entrypoint.sh"]
