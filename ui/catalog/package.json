{
  "name": "catalog-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0 --report-unused-disable-directives",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,scss}\"",
    "typecheck": "tsc -b --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "fix": "npm run lint:fix && npm run format"
  },
  "dependencies": {
    "@carbon/ibm-products": "^2.85.0",
    "@carbon/icons-react": "^11.76.0",
    "@carbon/react": "^1.103.0",
    "axios": "^1.18.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.4",
    "react-router": "^8.3.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "sass": "^1.98.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.1.4"
  },
  "overrides": {
    "react-table": {
      "react": "^19.2.0"
    }
  }
}
