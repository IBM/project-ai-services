FROM registry.access.redhat.com/ubi9/nodejs-22 AS build

# Switch to the non-root user
USER 1001
WORKDIR /app
COPY --chown=1001:0 package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM registry.access.redhat.com/ubi9/nginx-126:9.8

# Image provenance labels (populated via --build-arg, see hack/image-labels.mk)
ARG GIT_REPO=https://github.com/ibm/project-ai-services
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown
LABEL org.opencontainers.image.source="${GIT_REPO}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.title="Chatbot UI" \
      org.opencontainers.image.vendor="IBM" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.description="Chatbot UI for AI Services" \
      com.github.project-ai-services.containerfile="ui/chatbot/Containerfile" \
      com.github.project-ai-services.containerfile.url="${GIT_REPO}/blob/${GIT_COMMIT}/ui/chatbot/Containerfile"

USER root
RUN dnf update -y --disablerepo='*' --enablerepo='ubi-9-*' && dnf clean all
USER 1001

COPY nginx.conf.tmpl /etc

COPY --from=build /app/build /usr/share/nginx/html

EXPOSE 3000

# Render nginx.conf.tmpl with backend server details and start the nginx server
CMD /bin/bash -c "envsubst '\$BACKEND_HOST \$BACKEND_PORT \$SIMILARITY_SEARCH_HOST \$SIMILARITY_SEARCH_PORT \$CHATBOT_SEARCH_MODE \$CHATBOT_NUM_CHUNKS_POST_RERANKER \$CHATBOT_RERANK' < /etc/nginx.conf.tmpl > /etc/nginx/nginx.conf && nginx -g 'daemon off;'"
