worker_processes  auto;

error_log  /var/log/nginx/error.log warn;
pid        /tmp/nginx.pid;


events {
    worker_connections  1024;
}


http {
    proxy_temp_path /tmp/proxy_temp;
    client_body_temp_path /tmp/client_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;

    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    access_log  /var/log/nginx/access.log  main;

    sendfile        on;
    #tcp_nopush     on;

    keepalive_timeout  65;

    #gzip  on;

    server {
        listen 3000;

        # The sign-in page must not be framed (clickjacking). The chat holds a bearer token in memory.
        add_header Content-Security-Policy "frame-ancestors 'none';" always;
        add_header X-Frame-Options "DENY" always;

        # Serve the React app
        location / {
          root /usr/share/nginx/html;
          index index.html;
          try_files $uri /index.html;
        }

        # Trade the one-time sign-in code for a token at the catalog. The catalog's certificate is
        # verified: the code and the token cross this hop.
        location = /auth/exchange {
          proxy_pass ${CATALOG_API_URL}/api/v1/auth/code/exchange;
          proxy_set_header Host $proxy_host;
          proxy_ssl_server_name on;
          proxy_ssl_verify on;
          proxy_ssl_trusted_certificate ${AUTH_CATALOG_CA_BUNDLE};
        }

        # Proxy API requests. The Authorization header (the catalog token) is passed to the backend as is.
        location /v1/chat/completions {
          proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
          proxy_http_version 1.1;
          proxy_set_header Upgrade $http_upgrade;
          proxy_set_header Connection 'upgrade';
          proxy_set_header Host $host;
          proxy_cache_bypass $http_upgrade;
        }

        location /v1/models {
          proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
          proxy_http_version 1.1;
          proxy_set_header Upgrade $http_upgrade;
          proxy_set_header Connection 'upgrade';
          proxy_set_header Host $host;
          proxy_cache_bypass $http_upgrade;
        }

        location /db-status {
          proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
          proxy_http_version 1.1;
          proxy_set_header Upgrade $http_upgrade;
          proxy_set_header Connection 'upgrade';
          proxy_set_header Host $host;
          proxy_cache_bypass $http_upgrade;
        }
    }

    include /etc/nginx/conf.d/*.conf;
}
