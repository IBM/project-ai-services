FROM icr.io/ai-services-cicd/service-base:v0.0.39

WORKDIR /opt/services/chatbot

ENV PYTHONPATH=/opt/services

COPY common /opt/services/common
COPY chatbot/ .

# Uncomment when you have chatbot specific requirements.txt
# RUN source /var/venv/bin/activate && python -m ensurepip --upgrade && pip install -r requirements.txt --extra-index-url https://wheels.developerfirst.ibm.com/ppc64le/linux --prefer-binary && pip cache purge && rm -rf /var/venv/lib/python3.12/site-packages/pip /var/venv/lib/python3.12/site-packages/pip-*.dist-info /var/venv/bin/pip*

CMD ["/var/venv/bin/python", "-m", "uvicorn", "app:app", \
     "--host", "0.0.0.0", "--port", "5000", \
     "--loop", "uvloop", "--http", "httptools"]
