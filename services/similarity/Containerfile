FROM icr.io/ai-services-cicd/service-base:v0.0.45

# Image provenance labels (populated via --build-arg, see hack/image-labels.mk)
ARG GIT_REPO=https://github.com/ibm/project-ai-services
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown
LABEL org.opencontainers.image.source="${GIT_REPO}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.title="Similarity Service" \
      org.opencontainers.image.vendor="IBM" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.description="Similarity search service for AI Services" \
      com.github.project-ai-services.containerfile="services/similarity/Containerfile" \
      com.github.project-ai-services.containerfile.url="${GIT_REPO}/blob/${GIT_COMMIT}/services/similarity/Containerfile"

WORKDIR /opt/services/similarity

ENV PYTHONPATH=/opt/services

COPY common /opt/services/common
COPY similarity/ .

# Uncomment when you have similarity specific requirements.txt
# RUN source /var/venv/bin/activate && python -m ensurepip --upgrade && python -m pip install --upgrade pip && python -m pip install -r requirements.txt --extra-index-url https://wheels.developerfirst.ibm.com/ppc64le/linux --prefer-binary && python -m pip cache purge && rm -rf /var/venv/lib/python3.12/site-packages/pip /var/venv/lib/python3.12/site-packages/pip-*.dist-info /var/venv/bin/pip*

CMD ["/var/venv/bin/python", "-m", "uvicorn", "app:app", \
     "--host", "0.0.0.0", "--port", "7000", \
     "--loop", "uvloop", "--http", "httptools"]
