# -*- mode: Python -*-

# =============================================================================
# Tiltfile for the extract / translate / summarize / forecast services (macOS / local development)
# =============================================================================
#
# Runs ONE service with only its dependencies, chosen with the --service Tilt flag:
#   python-env     : lean venv (hack/tilt/services/.venv) shared by all services
#   postgres       : PostgreSQL in Podman (<svc>_metadata database)
#   <svc>-db-init  : creates the service database and schema (idempotent)
#   <svc>-api      : the service's FastAPI app, run from source with uvicorn --reload
#
# extract / translate / summarize only:
#   model-server   : hack/tilt/model_server.py in LLM-only mode (Ollama or watsonx.ai + /tokenize)
#
# forecast only (no LLM, so no model-server):
#   forecast-db-init also creates the restricted forecast_worker role
#   triton         : Triton Inference Server in Podman (explicit model control) on the model repository
#
# Usage:
#   tilt up -f hack/tilt/services/Tiltfile -- --service=extract
#   tilt up -f hack/tilt/services/Tiltfile -- --service=translate --llm_provider=watsonx
#   tilt up -f hack/tilt/services/Tiltfile -- --service=forecast
#   tilt down -f hack/tilt/services/Tiltfile -- --service=summarize
#
# Local development only - every credential below is a publicly documented default.
# See docs/dev-guides/tilt-services-local-development.md
# =============================================================================

REPO_ROOT = os.path.abspath(os.path.join(config.main_dir, "..", "..", ".."))
VENV = "hack/tilt/services/.venv"
REQUIREMENTS = "hack/tilt/services/requirements.txt"

# Default ports avoid browser-blocked (6000) and macOS AirPlay (5000, 7000) ports.
#   llm        : needs the LLM model server (LLM_* env, CACHE_DIR)
#   docs_path  : where the Swagger UI is served (the LLM services serve it at "/")
SERVICES = {
    "extract": {"title": "Extract", "port": 9500, "database": "extract_metadata", "llm": True},
    "translate": {"title": "Translate", "port": 9000, "database": "translate_metadata", "llm": True},
    "summarize": {"title": "Summarize", "port": 6100, "database": "summarize_metadata", "llm": True},
    "forecast": {
        "title": "Forecast", "port": 8500, "database": "forecast_metadata", "llm": False,
        "docs_path": "/docs",
    },
}


def _flag(cfg, name, default):
    return str(cfg.get(name, default))


def setup():
    """Defines the config flags, parses them and returns the settings dict used by the helpers below."""
    config.define_string("service", args=False)
    config.define_string("python_bin", args=False)
    config.define_string("llm_provider", args=False)
    config.define_string("ollama_url", args=False)
    config.define_string("ollama_model", args=False)
    config.define_string("watsonx_url", args=False)
    config.define_string("watsonx_project_id", args=False)
    config.define_string("watsonx_model", args=False)
    # NOTE: the watsonx API key is read from the WATSONX_APIKEY environment variable, never from a flag.
    config.define_string("llm_max_model_len", args=False)
    config.define_string("model_server_port", args=False)
    config.define_string("postgres_image", args=False)
    config.define_string("postgres_port", args=False)
    config.define_string("postgres_password", args=False)
    # forecast only
    config.define_string("worker_postgres_user", args=False)
    config.define_string("worker_postgres_password", args=False)
    config.define_string("triton_image", args=False)
    config.define_string("triton_platform", args=False)
    config.define_string("triton_port", args=False)
    for name in SERVICES:
        config.define_string(name + "_port", args=False)
    cfg = config.parse()

    profile = _flag(cfg, "service", "").strip().lower()
    if profile not in SERVICES:
        fail("pass --service=<name> (tilt up -f <Tiltfile> -- --service=extract); one of: {} (got '{}')".format(
            ", ".join(SERVICES.keys()), profile))
    index = list(SERVICES.keys()).index(profile)
    services = [profile]
    service = SERVICES[profile]

    llm_provider = _flag(cfg, "llm_provider", os.getenv("LLM_PROVIDER", "ollama")).strip().lower()
    if llm_provider not in ["ollama", "watsonx"]:
        fail("llm_provider must be 'ollama' or 'watsonx', got '{}'".format(llm_provider))
    ollama_model = _flag(cfg, "ollama_model", os.getenv("OLLAMA_MODEL", "granite4.1:8b"))
    watsonx_model = _flag(cfg, "watsonx_model", os.getenv("WATSONX_MODEL", "ibm/granite-4-h-small"))
    watsonx_url = _flag(cfg, "watsonx_url", os.getenv("WATSONX_URL", ""))
    watsonx_project_id = _flag(cfg, "watsonx_project_id", os.getenv("WATSONX_PROJECT_ID", ""))

    if service["llm"] and llm_provider == "watsonx" and not (
            watsonx_url and watsonx_project_id and os.getenv("WATSONX_APIKEY", "")):
        warn("llm_provider=watsonx: set WATSONX_URL, WATSONX_PROJECT_ID (or --watsonx_url/--watsonx_project_id) " +
             "and the WATSONX_APIKEY environment variable; LLM calls fail until they are set.")

    data_dir = os.path.join(REPO_ROOT, ".tilt/services", profile)
    triton_port = int(_flag(cfg, "triton_port", 8000))

    ctx = {
        "profile": profile,
        "services": services,
        "llm": service["llm"],
        "venv": VENV,
        "requirements": REQUIREMENTS,
        "python_bin": _flag(cfg, "python_bin", ""),
        "llm_provider": llm_provider,
        "ollama_url": _flag(cfg, "ollama_url", os.getenv("OLLAMA_URL", "http://127.0.0.1:11434/v1")),
        "ollama_model": ollama_model,
        "watsonx_url": watsonx_url,
        "watsonx_project_id": watsonx_project_id,
        "watsonx_model": watsonx_model,
        # Model name the services ask for (LLM_MODEL) and that the selected provider serves.
        "llm_model": watsonx_model if llm_provider == "watsonx" else ollama_model,
        "llm_max_model_len": int(_flag(cfg, "llm_max_model_len", 26208)),
        "model_server_port": int(_flag(cfg, "model_server_port", 8200 + index)),
        "postgres_image": _flag(cfg, "postgres_image", "docker.io/library/postgres:18-alpine"),
        # 5432 is the catalog Tiltfile, 5433 is Tiltfile.rag.
        "postgres_port": int(_flag(cfg, "postgres_port", 5434 + index)),
        # Local development default only (same as Tiltfile.rag / services values.yaml).
        "postgres_password": _flag(cfg, "postgres_password", "Aiservicesdb@1234"),
        "ports": {name: int(_flag(cfg, name + "_port", SERVICES[name]["port"])) for name in services},
        "pg_container": "ai-svc-{}-postgres".format(profile),
        "pg_volume": "ai-svc-{}-postgres-data".format(profile),
        "data_dir": data_dir,
    }
    ctx["containers"] = [ctx["pg_container"]]

    if profile == "forecast":
        ctx.update({
            "worker_postgres_user": _flag(cfg, "worker_postgres_user", "forecast_worker"),
            "worker_postgres_password": _flag(cfg, "worker_postgres_password", "ForecastWorker@1234"),
            # AES-256-GCM key: must be exactly 32 bytes, used as-is (not base64). Override with the
            # DB_ENCRYPTION_KEY environment variable; changing it makes stored connector secrets unreadable.
            "db_encryption_key": os.getenv("DB_ENCRYPTION_KEY", "forecast-local-dev-key-012345678"),
            # The proposal's image (quay.io/powercloud/tritonserver:2.70.0-0, Triton 2.70.0 = NGC release 26.06)
            # is ppc64le only. NVIDIA's 26.06-py3 is the same release and is multi-arch (amd64 + arm64), so
            # by default podman pulls the native build (Apple Silicon: arm64).
            # Set --triton_platform=linux/amd64 only to force emulation.
            "triton_image": _flag(cfg, "triton_image", "nvcr.io/nvidia/tritonserver:26.06-py3"),
            "triton_platform": _flag(cfg, "triton_platform", ""),
            "triton_port": triton_port,
            "triton_url": "http://localhost:{}".format(triton_port),
            "triton_container": "ai-svc-forecast-triton",
            "model_repo": os.path.join(data_dir, "models"),
        })
        ctx["containers"].append(ctx["triton_container"])
        # len() of a Starlark string is its size in bytes.
        if len(ctx["db_encryption_key"]) != 32:
            fail("DB_ENCRYPTION_KEY must be exactly 32 bytes (AES-256), got {}".format(len(ctx["db_encryption_key"])))

    # `tilt down` only deletes Kubernetes objects, so remove the containers, the volume and the
    # service caches here. The Python venv is kept on purpose: it is slow to recreate.
    if config.tilt_subcommand == "down":
        local(
            ("podman rm -f {c} >/dev/null 2>&1 || true; " +
             "podman volume rm -f {v} >/dev/null 2>&1 || true; " +
             "rm -rf '{d}'").format(c=" ".join(ctx["containers"]), v=ctx["pg_volume"], d=ctx["data_dir"]),
            quiet=True,
        )

    ctx["model_server_url"] = "http://localhost:{}".format(ctx["model_server_port"])
    return ctx


def _common_env(ctx, llm_env=""):
    """Environment shared by every service (same variables as the service podman pod templates)."""
    return """
    export PYTHONPATH="{root}/services"
{llm_env}    export LOG_LEVEL="INFO"
    export POSTGRES_HOST="localhost"
    export POSTGRES_PORT="{pg_port}"
    export POSTGRES_USER="postgres"
    export POSTGRES_PASSWORD='{pg_pass}'
    export DB_POOL_SIZE="5"
    export DB_MAX_OVERFLOW="5"
    export DISABLE_CRASH_HANDLER="1"
""".format(
        root=REPO_ROOT,
        llm_env=llm_env,
        pg_port=ctx["postgres_port"],
        pg_pass=ctx["postgres_password"],
    )


def _llm_env(ctx):
    """LLM settings of extract / translate / summarize."""
    return """    export LLM_ENDPOINT="{ms}/llm"
    export LLM_MODEL="{llm_model}"
    export LLM_MAX_MODEL_LEN="{max_len}"
    export LLM_MAX_BATCH_SIZE="32"
""".format(
        ms=ctx["model_server_url"],
        llm_model=ctx["llm_model"],
        max_len=ctx["llm_max_model_len"],
    )


def _forecast_env(ctx):
    """Forecast settings (same variables as the proposal's Configuration table)."""
    return """    export WORKER_POSTGRES_USER="{wuser}"
    export WORKER_POSTGRES_PASSWORD='{wpass}'
    export DB_ENCRYPTION_KEY='{key}'
    export TRITON_URL="{triton_url}"
    export MODEL_REPO_PATH="{models}"
    export SCRATCH_DIR="{scratch}"
    export DATA_DIR="{data}"
    mkdir -p "$MODEL_REPO_PATH" "$SCRATCH_DIR" "$DATA_DIR"
""".format(
        wuser=ctx["worker_postgres_user"],
        wpass=ctx["worker_postgres_password"],
        key=ctx["db_encryption_key"],
        triton_url=ctx["triton_url"],
        models=ctx["model_repo"],
        scratch=os.path.join(ctx["data_dir"], "scratch"),
        data=os.path.join(ctx["data_dir"], "data"),
    )


def _service_env(ctx, name):
    service_env = """
    export POSTGRES_DB="{db}"
    export PORT="{port}"
""".format(db=SERVICES[name]["database"], port=ctx["ports"][name])
    if SERVICES[name]["llm"]:
        cache = os.path.join(ctx["data_dir"], name, "cache")
        return _common_env(ctx, _llm_env(ctx)) + service_env + """    export CACHE_DIR="{cache}"
    mkdir -p "$CACHE_DIR"
""".format(cache=cache)
    return _common_env(ctx) + service_env + _forecast_env(ctx)


def add_python_env(ctx):
    # Created once. Picks the first Python >= 3.12 found unless --python_bin is given
    # (the macOS system python3 3.9 is too old).
    local_resource(
        name="python-env",
        dir=REPO_ROOT,
        cmd="""
            set -e
            if [ ! -x {venv}/bin/python ]; then
                PY="{py}"
                if [ -z "$PY" ]; then
                    for c in python3.12 python3.13 python3.14 python3; do
                        if command -v "$c" >/dev/null 2>&1 && "$c" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 12) else 1)' >/dev/null 2>&1; then PY="$c"; break; fi
                    done
                fi
                if [ -z "$PY" ] || ! "$PY" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 12) else 1)'; then
                    echo "ERROR: Python >= 3.12 is required; pass --python_bin=python3.12"
                    exit 1
                fi
                "$PY" -m venv {venv}
            fi
            {venv}/bin/pip install -q -r {req}
        """.format(venv=ctx["venv"], py=ctx["python_bin"], req=ctx["requirements"]),
        deps=[os.path.join(REPO_ROOT, ctx["requirements"])],
        labels=["setup"],
    )


def add_postgres(ctx):
    # postgres 18+ refuses to start if the volume is mounted at /var/lib/postgresql/data; mount /var/lib/postgresql.
    local_resource(
        name="postgres",
        serve_dir=REPO_ROOT,
        serve_cmd="""
            podman rm -f {container} 2>/dev/null || true
            podman run --rm --name {container} \
                -p {port}:5432 \
                -e POSTGRES_USER=postgres \
                -e POSTGRES_PASSWORD='{password}' \
                -e POSTGRES_DB=postgres \
                -v {volume}:/var/lib/postgresql \
                {image}
        """.format(
            container=ctx["pg_container"],
            port=ctx["postgres_port"],
            password=ctx["postgres_password"],
            volume=ctx["pg_volume"],
            image=ctx["postgres_image"],
        ),
        labels=["database"],
        readiness_probe=probe(
            initial_delay_secs=5,
            period_secs=3,
            exec=exec_action(["podman", "exec", ctx["pg_container"], "pg_isready", "-U", "postgres"]),
        ),
    )


def add_model_server(ctx):
    # LLM-only mode: serves /llm (Ollama or watsonx.ai through LiteLLM) and the local /llm/tokenize
    # the services use for token counting. No torch, embedding model or reranker is loaded.
    local_resource(
        name="model-server",
        serve_dir=REPO_ROOT,
        serve_cmd="""
            set -e
            export MODEL_SERVER_MODELS="llm"
            export MODEL_SERVER_PORT="{port}"
            export LLM_MAX_LEN="{max_len}"
            export LLM_PROVIDER="{provider}"
            export OLLAMA_URL="{ollama_url}"
            export OLLAMA_MODEL="{ollama_model}"
            export WATSONX_URL="{wx_url}"
            export WATSONX_PROJECT_ID="{wx_project}"
            export WATSONX_MODEL="{wx_model}"
            # WATSONX_APIKEY is inherited from the environment that started Tilt.
            exec {venv}/bin/python hack/tilt/model_server.py
        """.format(
            port=ctx["model_server_port"],
            max_len=ctx["llm_max_model_len"],
            provider=ctx["llm_provider"],
            ollama_url=ctx["ollama_url"],
            ollama_model=ctx["ollama_model"],
            wx_url=ctx["watsonx_url"],
            wx_project=ctx["watsonx_project_id"],
            wx_model=ctx["watsonx_model"],
            venv=ctx["venv"],
        ),
        deps=[os.path.join(REPO_ROOT, "hack/tilt/model_server.py")],
        resource_deps=["python-env"],
        labels=["models"],
        readiness_probe=probe(
            initial_delay_secs=5,
            period_secs=5,
            http_get=http_get_action(port=ctx["model_server_port"], path="/health"),
        ),
    )


def add_triton(ctx):
    # Same flags as the proposal's Podman template (section 10.2): explicit model control, so nothing
    # is loaded until the API asks; strict readiness off and exit-on-error off, so one bad model
    # does not take the server down. The repository is mounted read-only, as in the proposal:
    # the forecast API (running on the host) is the only writer.
    local_resource(
        name="triton",
        serve_dir=REPO_ROOT,
        serve_cmd="""
            mkdir -p '{models}'
            podman rm -f {container} 2>/dev/null || true
            exec podman run --rm --name {container} \
                {platform} \
                -p {port}:8000 \
                -v '{models}':/models:ro \
                {image} \
                tritonserver \
                --model-repository=/models \
                --model-control-mode=explicit \
                --strict-readiness=false \
                --exit-on-error=false \
                --http-port=8000 --grpc-port=8001 --metrics-port=8002
        """.format(
            container=ctx["triton_container"],
            platform=("--platform " + ctx["triton_platform"]) if ctx["triton_platform"] else "",
            port=ctx["triton_port"],
            models=ctx["model_repo"],
            image=ctx["triton_image"],
        ),
        labels=["inference"],
        readiness_probe=probe(
            initial_delay_secs=15,
            period_secs=5,
            timeout_secs=5,
            http_get=http_get_action(port=ctx["triton_port"], path="/v2/health/ready"),
        ),
    )


def add_service(ctx, name):
    port = ctx["ports"][name]
    title = SERVICES[name]["title"]
    env = _service_env(ctx, name)

    # Creates the <svc>_metadata database and its schema (idempotent). For forecast the same script
    # also creates the restricted worker role.
    local_resource(
        name=name + "-db-init",
        dir=REPO_ROOT,
        cmd="""
            set -e
            {env}
            cd services
            ../{venv}/bin/python {name}/db/scripts/init_db.py
        """.format(env=env, venv=ctx["venv"], name=name),
        deps=[
            os.path.join(REPO_ROOT, "services", name, "db/scripts"),
            os.path.join(REPO_ROOT, "services/common/db/scripts"),
        ],
        resource_deps=["postgres", "python-env"],
        labels=[name, "setup"],
    )

    # The LLM apps tokenize with the LLM (/llm/tokenize) at startup or first request, so wait for the
    # model server. Forecast waits for Triton instead.
    runtime_dep = "model-server" if ctx["llm"] else "triton"
    local_resource(
        name=name + "-api",
        serve_dir=REPO_ROOT,
        serve_cmd="""
            set -e
            {env}
            cd services
            exec ../{venv}/bin/python -m uvicorn {name}.app:app \
                --host 0.0.0.0 --port {port} --reload \
                --reload-dir {name} --reload-dir common
        """.format(env=env, venv=ctx["venv"], name=name, port=port),
        resource_deps=[name + "-db-init", runtime_dep],
        labels=[name, "backend"],
        links=[link("http://localhost:{}{}".format(port, SERVICES[name].get("docs_path", "")),
                    "{} API (Swagger)".format(title))],
        readiness_probe=probe(
            initial_delay_secs=5,
            period_secs=5,
            timeout_secs=5,
            http_get=http_get_action(port=port, path="/health"),
        ),
    )


def add_quick_links(ctx):
    lines = "\n".join([
        'echo "{} API: http://localhost:{}{}"'.format(
            SERVICES[n]["title"], ctx["ports"][n], SERVICES[n].get("docs_path", ""))
        for n in ctx["services"]
    ])
    if ctx["llm"]:
        lines += '\necho "Model server    : {} (LLM provider: {}, model: {})"'.format(
            ctx["model_server_url"], ctx["llm_provider"], ctx["llm_model"])
    else:
        lines += '\necho "PostgreSQL      : localhost:{}"'.format(ctx["postgres_port"])
        lines += '\necho "Triton          : {}"'.format(ctx["triton_url"])
        lines += '\necho "Model repository: {}"'.format(ctx["model_repo"])
    local_resource(
        name="quick-links",
        cmd=lines,
        labels=["quick-links"],
        links=[
            link("http://localhost:{}{}".format(ctx["ports"][n], SERVICES[n].get("docs_path", "")),
                 "{} API (Swagger)".format(SERVICES[n]["title"]))
            for n in ctx["services"]
        ],
    )


def run():
    ctx = setup()
    add_quick_links(ctx)
    add_python_env(ctx)
    add_postgres(ctx)
    if ctx["llm"]:
        add_model_server(ctx)
    else:
        add_triton(ctx)
    for name in ctx["services"]:
        add_service(ctx, name)


run()
