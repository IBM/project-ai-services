FROM localhost/prebuilder as prebuilder

FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8

# Image provenance labels (populated via --build-arg, see hack/image-labels.mk)
ARG GIT_REPO=https://github.com/ibm/project-ai-services
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown
LABEL org.opencontainers.image.source="${GIT_REPO}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.title="AI Services Service Base" \
      org.opencontainers.image.vendor="IBM" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.description="Base image with Python runtime, dependencies and Docling models for AI services" \
      com.github.project-ai-services.containerfile="images/service-base/Containerfile" \
      com.github.project-ai-services.containerfile.url="${GIT_REPO}/blob/${GIT_COMMIT}/images/service-base/Containerfile"

RUN microdnf update -y --disablerepo='*' --enablerepo='ubi-9-*' && microdnf clean all

RUN microdnf install -y python3.12-devel \
        lcms2-devel openblas-devel freetype libicu libjpeg-turbo && \
    curl -o /tmp/epel-release.rpm https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm && \
    rpm -ivh /tmp/epel-release.rpm && \
    rm -f /tmp/epel-release.rpm && \
    microdnf install -y spatialindex-devel && \
    microdnf clean all && \
    rm -rf /usr/bin/python && rm -rf /usr/bin/python3 && \
    ln -s /usr/bin/python3.12 /usr/bin/python && ln -s /usr/bin/python3.12 /usr/bin/python3

ENV DOCLING_MODELS_PATH=/var/docling-models
# Disable hf-xet (Rust/Tokio Xet transfer extension) during the model download
# build step. hf-xet 1.x initialises a global Tokio multi-thread runtime on
# import; when huggingface_hub calls into it from within a Tokio worker thread
# the Rust runtime tries to re-enter Python's import machinery from a thread
# that already owns the GIL bootstrap lock, producing:
#   Fatal Python error: _PyImport_Init: global import state already initialized
# The docling models are served from standard HuggingFace Hub storage, not xet,
# so disabling xet has no effect on download behaviour or speed.
ENV HF_HUB_DISABLE_XET=1

COPY requirements.txt .
COPY download_docling_models.py .

# `python -m venv` bootstraps its own pip via the stdlib ensurepip module, so no
# separate get-pip.py bootstrap is needed. pip is only used to install the packages
# below; it is not used at runtime. Strip the extracted pip from the venv afterwards
# so the runtime image ships no pip -- and none of pip's vendored libraries
# (requests, urllib3, certifi, ...) or its CycloneDX SBOM that scanners flag.
RUN --mount=type=bind,from=prebuilder,source=/wheels,target=/wheels,ro \
    python -m venv /var/venv && source /var/venv/bin/activate && \
    pip install --upgrade pip && \
    pip install /wheels/*.whl -r requirements.txt \
        --extra-index-url https://wheels.developerfirst.ibm.com/ppc64le/linux \
        --prefer-binary && \
    pip cache purge && \
    python download_docling_models.py && \
    rm -rf ~/.cache/huggingface && \
    rm -rf /var/venv/lib/python3.12/site-packages/pip \
           /var/venv/lib/python3.12/site-packages/pip-*.dist-info \
           /var/venv/bin/pip /var/venv/bin/pip3 /var/venv/bin/pip3.12
