FROM localhost/prebuilder as prebuilder

FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8

RUN microdnf update -y --disablerepo='*' --enablerepo='ubi-9-*' && microdnf clean all

RUN microdnf install -y python3.12-devel && \
    microdnf clean all && \
    rm -rf /usr/bin/python && rm -rf /usr/bin/python3 && \
    ln -s /usr/bin/python3.12 /usr/bin/python && ln -s /usr/bin/python3.12 /usr/bin/python3

COPY requirements.txt .

# `python -m venv` bootstraps its own pip via the stdlib ensurepip module, so no
# separate get-pip.py bootstrap is needed. pip is only used to install the packages
# below; it is not used at runtime. Strip the extracted pip from the venv afterwards
# so the runtime image ships no pip -- and none of pip's vendored libraries
# (requests, urllib3, certifi, ...) or its CycloneDX SBOM that scanners flag.
RUN --mount=type=bind,from=prebuilder,source=/wheels,target=/wheels,ro \
    python -m venv /var/venv && source /var/venv/bin/activate && \
    pip install --upgrade pip && \
    pip install /wheels/*.whl -r requirements.txt \
        --extra-index-url https://wheels.developerfirst.ibm.com/ppc64le/linux \
        --prefer-binary && \
    pip cache purge && \
    rm -rf /var/venv/lib/python3.12/site-packages/pip \
           /var/venv/lib/python3.12/site-packages/pip-*.dist-info \
           /var/venv/bin/pip /var/venv/bin/pip3 /var/venv/bin/pip3.12
