--- /dev/null
+++ b/litellm/proxy/pass_through_endpoints/llm_provider_handlers/vllm_passthrough_handler.py
@@ -0,0 +1,101 @@
+from collections.abc import Mapping, Sequence
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Final
+
+from litellm._logging import verbose_router_logger
+from litellm.exceptions import BadRequestError
+from litellm.litellm_core_utils.credential_accessor import CredentialAccessor
+from litellm.litellm_core_utils.get_llm_provider_logic import get_llm_provider
+from litellm.llms.vllm.common_utils import without_last_path_segment
+from litellm.proxy.pass_through_endpoints.llm_provider_handlers.watsonx_passthrough_handler import (
+    WatsonxPassthroughHandler,
+)
+from litellm.types.router import DeploymentTypedDict, LiteLLMParamsTypedDict
+
+if TYPE_CHECKING:
+    from litellm.proxy._types import UserAPIKeyAuth
+
+_VLLM_PROVIDER: Final = "hosted_vllm"
+
+
+@dataclass(frozen=True, slots=True)
+class VLLMPassThroughCredentials:
+    api_key: str | None
+    api_base: str | None
+    model: str
+
+
+def _model_matches(creds: VLLMPassThroughCredentials, model_id: str) -> bool:
+    return creds.model == model_id or creds.model.endswith(f"/{model_id}")
+
+
+def resolve_credentials_from_deployment(litellm_params: LiteLLMParamsTypedDict) -> VLLMPassThroughCredentials | None:
+    model: Final = litellm_params.get("model")
+    if model is None:
+        return None
+    try:
+        _, provider, _, _ = get_llm_provider(
+            model=model,
+            custom_llm_provider=litellm_params.get("custom_llm_provider"),
+        )
+    except BadRequestError:
+        return None
+    if provider != _VLLM_PROVIDER:
+        return None
+    credential_name: Final = litellm_params.get("litellm_credential_name")
+    credential_values: Final[Mapping[str, object]] = (
+        CredentialAccessor.get_credential_values(credential_name) if credential_name is not None else {}
+    )
+    credential_api_key: Final = credential_values.get("api_key")
+    credential_api_base: Final = credential_values.get("api_base")
+    deployment_api_base: Final = (
+        credential_api_base if isinstance(credential_api_base, str) else None
+    ) or litellm_params.get("api_base")
+    return VLLMPassThroughCredentials(
+        api_key=(credential_api_key if isinstance(credential_api_key, str) else None)
+        or litellm_params.get("api_key"),
+        api_base=without_last_path_segment(deployment_api_base) if deployment_api_base else None,
+        model=model,
+    )
+
+
+async def allowed_deployments(
+    user_api_key_dict: "UserAPIKeyAuth",
+    requested_model: str | None = None,
+) -> Sequence[DeploymentTypedDict]:
+    deployments: Final = await WatsonxPassthroughHandler.allowed_deployments(
+        user_api_key_dict=user_api_key_dict,
+        requested_model=requested_model,
+    )
+    return tuple(
+        deployment
+        for deployment in deployments
+        if resolve_credentials_from_deployment(deployment["litellm_params"]) is not None
+    )
+
+
+def resolve_credentials_from_router_deployments(
+    model_id: str | None,
+    deployments: Sequence[DeploymentTypedDict],
+) -> VLLMPassThroughCredentials | None:
+    candidates: Final = tuple(
+        creds
+        for deployment in deployments
+        if (creds := resolve_credentials_from_deployment(deployment["litellm_params"])) is not None
+    )
+    if not candidates:
+        return None
+
+    matched: Final = next(
+        (creds for creds in candidates if model_id is not None and _model_matches(creds, model_id)),
+        None,
+    )
+    if matched is not None:
+        return matched
+
+    if len(candidates) > 1:
+        verbose_router_logger.warning(
+            "Multiple vllm use_in_pass_through deployments found but no request model matched. "
+            "Using the first one. Pass the deployment's model in the request body to route to the correct credentials."
+        )
+    return candidates[0]
