FROM registry.access.redhat.com/ubi9/ubi:9.8 AS builder

ARG DNF_FLAGS="--disablerepo=* --enablerepo=ubi-9-baseos-rpms --enablerepo=ubi-9-appstream-rpms"
ARG CADDY_VERSION=v2.11.7
ARG GO_VERSION=1.26.10

RUN dnf update ${DNF_FLAGS} -y && \
    dnf install ${DNF_FLAGS} -y git ca-certificates wget && \
    dnf clean all

RUN curl -fsSL https://go.dev/dl/go${GO_VERSION}.linux-ppc64le.tar.gz -o go.tar.gz && \
    tar -C /usr/local -xzf go.tar.gz && \
    rm go.tar.gz

ENV PATH="/usr/local/go/bin:${PATH}"

RUN set -eux; \
    mkdir -p /out/etc/caddy /out/usr/share/caddy /out/config/caddy /out/data/caddy; \
    wget -O /out/etc/caddy/Caddyfile "https://github.com/caddyserver/dist/raw/${CADDY_VERSION}/config/Caddyfile"; \
    wget -O /out/usr/share/caddy/index.html "https://github.com/caddyserver/dist/raw/${CADDY_VERSION}/welcome/index.html"

COPY patches/ /tmp/patches/

RUN set -eux; \
    git clone --depth 1 --branch ${CADDY_VERSION} https://github.com/caddyserver/caddy.git /tmp/caddy; \
    cd /tmp/caddy; \
    PATCH_FILE="/tmp/patches/caddy_${CADDY_VERSION}.patch"; \
    if [ -f "${PATCH_FILE}" ]; then git apply "${PATCH_FILE}"; fi; \
    CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/usr/bin/caddy ./cmd/caddy; \
    /out/usr/bin/caddy version

FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8

# Image provenance labels (populated via --build-arg, see hack/image-labels.mk)
ARG GIT_REPO=https://github.com/ibm/project-ai-services
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown
ARG CADDY_VERSION=v2.11.7
LABEL org.opencontainers.image.source="${GIT_REPO}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.version="${CADDY_VERSION}" \
      org.opencontainers.image.title="Caddy" \
      org.opencontainers.image.vendor="IBM" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.description="A powerful, enterprise-ready, open source web server with automatic HTTPS written in Go" \
      com.github.project-ai-services.containerfile="images/caddy/Containerfile" \
      com.github.project-ai-services.containerfile.url="${GIT_REPO}/blob/${GIT_COMMIT}/images/caddy/Containerfile"

ARG DNF_FLAGS="--disablerepo=* --enablerepo=ubi-9-baseos-rpms --enablerepo=ubi-9-appstream-rpms"

COPY --from=builder /out/ /

RUN set -eux; \
    microdnf update ${DNF_FLAGS} -y; \
    microdnf install ${DNF_FLAGS} -y ca-certificates libcap shadow-utils; \
    groupadd --gid 1000 caddy; \
    useradd --uid 1000 --gid caddy --home-dir /srv --shell /sbin/nologin --no-create-home caddy; \
    microdnf remove ${DNF_FLAGS} -y shadow-utils; \
    microdnf clean all; \
    setcap cap_net_bind_service=+ep /usr/bin/caddy; \
    chmod +x /usr/bin/caddy; \
    chown -R caddy:caddy /config /data; \
    caddy version

ENV XDG_CONFIG_HOME=/config
ENV XDG_DATA_HOME=/data

EXPOSE 80/tcp
EXPOSE 443/tcp
EXPOSE 443/udp
EXPOSE 2019/tcp

WORKDIR /srv

USER caddy

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
