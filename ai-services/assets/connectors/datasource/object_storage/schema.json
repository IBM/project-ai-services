{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "endpoint_url",
    "bucket_name",
    "access_key_id",
    "secret_access_key",
    "allowed_extensions"
  ],
  "properties": {
    "endpoint_url": {
      "type": "string",
      "title": "Endpoint URL",
      "description": "S3 endpoint URL (e.g. https://s3.us-east-1.amazonaws.com).",
      "format": "uri",
      "ui:section": "Location"
    },
    "bucket_name": {
      "type": "string",
      "title": "Bucket name",
      "description": "Name of the S3 bucket to use as the content source.",
      "ui:section": "Location"
    },
    "access_key_id": {
      "type": "string",
      "title": "Access key ID",
      "description": "S3-compatible access key identifier.",
      "ui:section": "Authentication"
    },
    "secret_access_key": {
      "type": "string",
      "title": "Secret access key",
      "description": "S3-compatible secret access key.",
      "format": "password",
      "ui:section": "Authentication"
    },
    "prefix": {
      "type": "string",
      "title": "Prefix (optional)",
      "description": "Optional key prefix to scope the connector to a sub-path within the bucket.",
      "ui:section": "Location"
    },
    "delimiter": {
      "type": "string",
      "title": "Delimiter (optional)",
      "description": "Optional delimiter character used when listing objects (e.g. '/').",
      "ui:section": "Location"
    },
    "allowed_extensions": {
      "type": "array",
      "title": "File filters",
      "description": "Restrict ingestion to files whose name ends with one of these extensions.",
      "ui:section": "File filters",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          ".pdf",
          ".docx"
        ]
      }
    }
  }
}
