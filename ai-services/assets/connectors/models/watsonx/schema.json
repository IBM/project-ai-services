{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_key", "project_id", "api_base"],
  "properties": {
    "api_key": {
      "type": "string",
      "title": "API key",
      "format": "password",
      "description": "API key for accessing watsonx",
      "pattern": "^[A-Za-z0-9_-]{44}$",
      "minLength": 44,
      "maxLength": 44
    },
    "project_id": {
      "type": "string",
      "title": "Project ID",
      "description": "Find your ID on the watsonx cloud site when you create a project.\n\n[Open project](https://dataplatform.cloud.ibm.com/projects/?context=wx)",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "api_base": {
      "type": "string",
      "title": "API endpoint",
      "description": "API Endpoint for accessing watsonx",
      "pattern": "^https://[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\\.[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*(/.*)?$"
    }
  }
}
