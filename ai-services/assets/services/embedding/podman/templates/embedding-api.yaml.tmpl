apiVersion: v1
kind: Pod
metadata:
  name: "embedding-api-{{ .InstanceSlug }}"
  labels:
    ai-services.io/template: "{{ .TemplateID }}"
  annotations:
    ai-services.io/routes: "7000:embedding-api-{{ .InstanceSlug }}:api"
spec:
  restartPolicy: always
  containers:
    - name: embedding-api
      image: "{{ .Values.embedding.image }}"
      env:
        - name: PORT
          value: "7000"
        - name: EMBEDDING_MODEL_NAME
          value: "{{ .Values.model }}"
        - name: EMB_ENDPOINT
          value: "http://{{ .Values.embedding.host }}:{{ .Values.embedding.port }}"
        - name: LOG_LEVEL
          value: "{{ .Values.embedding.log_level }}"
      resources:
        requests:
          memory: "512Mi"
        limits:
          memory: "1Gi"
      ports:
        - containerPort: 7000
          protocol: TCP
      livenessProbe:
        httpGet:
          path: /health
          port: 7000
        initialDelaySeconds: 10
        periodSeconds: 30
        timeoutSeconds: 5
        failureThreshold: 3
