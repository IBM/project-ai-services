apiVersion: v1
kind: Secret
metadata:
  name: "forecast-db-secret-{{ .InstanceSlug }}"
  labels:
    ai-services.io/template: "{{ .TemplateID }}"
type: Opaque
stringData:
  username: "{{ .Values.postgres.username }}"
  password: "{{ .Values.postgres.password }}"
  worker_username: "{{ .Values.forecast.workerUsername }}"
  worker_password: "{{ .Values.forecast.workerPassword }}"
