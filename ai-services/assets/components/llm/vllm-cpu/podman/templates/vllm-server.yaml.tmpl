apiVersion: v1
kind: Pod
metadata:
  name: "llm-{{ .InstanceSlug }}"
  labels:
    ai-services.io/template: "{{ .TemplateID }}"
  annotations:
    io.podman.annotations.ulimit: "nofile=134217728:134217728,memlock=-1:-1"
spec:
  restartPolicy: always
  volumes:
    - name: dshm
      emptyDir:
        medium: Memory
        sizeLimit: 512Mi
    - name: models
      hostPath:
        path: "{{ .BaseDir }}/models"
        type: Directory
  containers:
    - name: llm
      image: "{{ .Values.image }}"
      command: ["/bin/sh"]
      args:
        - "-c"
        - |
          exec vllm serve /models/{{ .Values.model }} \
            --served-model-name {{ .Values.model }} \
            --max-num-batched-tokens={{ .Values.maxNumBatchedTokens }} \
            --max-model-len={{ .Values.maxModelLen }} \
            --port=8000
      livenessProbe:
        httpGet:
          path: /health
          port: 8000
        initialDelaySeconds: 120
        periodSeconds: 30
        timeoutSeconds: 5
        failureThreshold: 12
      env:
      - name: VLLM_CPU_OMP_THREADS_BIND
        value: auto
      - name: VLLM_CPU_KVCACHE_SPACE
        value: "32"
      resources:
        requests:
          memory: "{{ .Values.resources.memory }}"
        limits:
          memory: "{{ .Values.resources.memory }}"
      ports:
        - containerPort: 8000
      volumeMounts:
        - mountPath: /dev/shm
          name: dshm
        - mountPath: /models:z
          name: models
          readOnly: true
