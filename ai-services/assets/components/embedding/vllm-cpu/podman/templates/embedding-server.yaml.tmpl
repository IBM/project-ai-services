apiVersion: v1
kind: Pod
metadata:
  name: "embedding-{{ .InstanceSlug }}"
  labels:
    ai-services.io/template: "{{ .TemplateID }}"
  annotations:
    io.podman.annotations.ulimit: "nofile=134217728:134217728,memlock=-1:-1"
spec:
  restartPolicy: always
  volumes:
    - name: dshm
      emptyDir:
        medium: Memory
        sizeLimit: 512Mi
    - name: models
      hostPath:
        path: "{{ .BaseDir }}/models"
        type: Directory
  containers:
    - name: embedding
      image: "{{ .Values.image }}"
      args:
      - --model
      - /models/{{ .Values.model }}
      - --served-model-name
      - {{ .Values.model }}
      - --port=8001
      - --gpu-memory-utilization=0.5
      livenessProbe:
        httpGet:
          path: /health
          port: 8001
        initialDelaySeconds: 120
        periodSeconds: 30
        timeoutSeconds: 5
        failureThreshold: 3
      env:
        - name: OMP_NUM_THREADS
          value: "16"
      resources:
        requests:
          memory: "8Gi"
        limits:
          memory: "8Gi"
      ports:
        - containerPort: 8001
      volumeMounts:
        - mountPath: /dev/shm
          name: dshm
        - mountPath: /models:z
          name: models
          readOnly: true
