apiVersion: v1
kind: Pod
metadata:
  name: "{{ .AppName }}--caddy"
  labels:
    ai-services.io/application: "{{ .AppName }}"
    ai-services.io/template: "{{ .AppTemplateName }}"
    ai-services.io/version: "{{ .Version }}"
    ai-services.io/component: "proxy"
    {{- if and .Values.caddy.sslCertContent .Values.caddy.sslKeyContent }}
    ai-services.io/secret: "caddy-cert-secret"
    ai-services.io/secret-skip-cleanup: "true"
    {{- end }}
    ai-services.io/volume: "caddy-worker,caddy-cert-secret"
    ai-services.io/volume-skip-cleanup: "true"
  annotations:
    ai-services.io/ports: "127.0.0.1:{{ .Values.caddy.adminPort }}:2019, {{ .Values.caddy.httpsPort }}:443, {{ .Values.caddy.privateIngressPort }}:9443"
spec:
  restartPolicy: always
  initContainers:
    - name: generate-caddyfile
      image: "{{ .Values.caddy.image }}"
      imagePullPolicy: IfNotPresent
      command:
        - "sh"
        - "-c"
        - |
          cat << 'EOF' > /data/caddy/Caddyfile
          {{- if .Values.caddy.caddyFileContent }}
{{ .Values.caddy.caddyFileContent }}
          {{- else }}
          # No Caddyfile
          {{- end }}
          EOF
      volumeMounts:
        - name: caddy-data
          mountPath: /data:z
    # The :9443 private ingress needs the certificate the worker receives at
    # registration. Block Caddy's start until all three files exist so it does not
    # crash-loop on missing files while the worker is still joining.
    - name: wait-for-worker-tls
      image: "{{ .Values.caddy.image }}"
      imagePullPolicy: IfNotPresent
      command:
        - "sh"
        - "-c"
        - |
          for i in $(seq 1 90); do
            if [ -s /data/worker-tls/tls.crt ] && [ -s /data/worker-tls/ca.crt ] && [ -s /data/worker-tls/tls.key.pem ]; then
              exit 0
            fi
            sleep 2
          done
          echo "timed out waiting for worker TLS material in /data/worker-tls; the worker has not joined" >&2
          exit 1
      volumeMounts:
        - name: worker-tls
          mountPath: /data/worker-tls
          readOnly: true
  containers:
    - name: caddy
      image: "{{ .Values.caddy.image }}"
      imagePullPolicy: IfNotPresent
      args: ["caddy", "run", "--config", "/data/caddy/Caddyfile", "--resume"]
      env:
        - name: CADDY_ADMIN
          # Bind to all interfaces inside the container so the host-side
          # port mapping (127.0.0.1:<random>:2019) can reach it.
          value: "0.0.0.0:2019"
      volumeMounts:
        - name: caddy-data
          mountPath: /data:z
        - name: caddy-data
          mountPath: /config:z
        # Worker cert, CA and the plaintext key (tls.key.pem) used by the :9443 private
        # ingress. Written by the worker pod once it has registered, so this pod must
        # start after the worker has joined.
        - name: worker-tls
          mountPath: /data/worker-tls
          readOnly: true
        {{- if and .Values.caddy.sslCertContent .Values.caddy.sslKeyContent }}
        - name: caddy-certs
          mountPath: /etc/secret/ssl
          readOnly: true
        {{- end }}
      resources:
        requests:
          memory: "256Mi"
        limits:
          memory: "512Mi"
      livenessProbe:
        httpGet:
          path: /health
          port: 8080
          scheme: HTTP
        initialDelaySeconds: 5
        periodSeconds: 10
        timeoutSeconds: 5
        failureThreshold: 3
  volumes:
    - name: caddy-data
      persistentVolumeClaim:
        claimName: "caddy-worker"
    - name: worker-tls
      persistentVolumeClaim:
        claimName: "worker-tls"
    {{- if and .Values.caddy.sslCertContent .Values.caddy.sslKeyContent }}
    - name: caddy-certs
      secret:
        secretName: caddy-cert-secret
    {{- end }}
