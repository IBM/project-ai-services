apiVersion: v1
kind: Pod
metadata:
  name: "{{ .AppName }}--caddy"
  labels:
    ai-services.io/application: "{{ .AppName }}"
    ai-services.io/template: "{{ .AppTemplateName }}"
    ai-services.io/version: "{{ .Version }}"
    ai-services.io/component: "proxy"
    {{- if and .Values.caddy.sslCertContent .Values.caddy.sslKeyContent }}
    ai-services.io/secret: "caddy-cert-secret"
    ai-services.io/secret-skip-cleanup: "true"
    {{- end }}
    ai-services.io/volume: "caddy-worker,caddy-cert-secret"
    ai-services.io/volume-skip-cleanup: "true"
  annotations:
    ai-services.io/ports: "127.0.0.1:{{ .Values.caddy.adminPort }}:2019, {{ .Values.caddy.httpsPort }}:443, {{ .Values.caddy.privateIngressPort }}:9443"
spec:
  restartPolicy: always
  initContainers:
    - name: generate-caddyfile
      image: "{{ .Values.caddy.image }}"
      imagePullPolicy: IfNotPresent
      command:
        - "sh"
        - "-c"
        - |
          cat << 'EOF' > /data/caddy/Caddyfile
          {{- if .Values.caddy.caddyFileContent }}
{{ .Values.caddy.caddyFileContent }}
          {{- else }}
          # No Caddyfile
          {{- end }}
          EOF
      volumeMounts:
        - name: caddy-data
          mountPath: /data:z
    # Caddy reads the trusted CA file (ca.crt) of the :9443 private ingress when it
    # loads its config, so it cannot start before the worker has joined and written
    # it. Wait up to 90 x 2s = 180s for it instead of crash-looping. tls.crt and the
    # encrypted tls.key are read per handshake by the encrypted_file module.
    - name: wait-for-worker-tls
      image: "{{ .Values.caddy.image }}"
      imagePullPolicy: IfNotPresent
      command:
        - "sh"
        - "-c"
        - |
          for i in $(seq 1 90); do
            if [ -s /data/worker-tls/ca.crt ]; then
              exit 0
            fi
            sleep 2
          done
          echo "timed out waiting for /data/worker-tls/ca.crt; the worker has not joined" >&2
          exit 1
      volumeMounts:
        - name: worker-tls
          mountPath: /data/worker-tls
          readOnly: true
  containers:
    - name: caddy
      image: "{{ .Values.caddy.image }}"
      imagePullPolicy: IfNotPresent
      args: ["caddy", "run", "--config", "/data/caddy/Caddyfile", "--resume"]
      env:
        - name: CADDY_ADMIN
          # Bind to all interfaces inside the container so the host-side
          # port mapping (127.0.0.1:<random>:2019) can reach it.
          value: "0.0.0.0:2019"
      volumeMounts:
        - name: caddy-data
          mountPath: /data:z
        - name: caddy-data
          mountPath: /config:z
        # Worker cert, CA and the AES-GCM encrypted key (tls.key) used by the :9443
        # private ingress. Written by the worker pod once it has registered.
        - name: worker-tls
          mountPath: /data/worker-tls
          readOnly: true
        # Secret the encrypted_file module uses to decrypt tls.key in memory.
        - name: worker-mtls-encryption-secret
          mountPath: /etc/secret/worker-mtls-encryption-secret
          readOnly: true
        {{- if and .Values.caddy.sslCertContent .Values.caddy.sslKeyContent }}
        - name: caddy-certs
          mountPath: /etc/secret/ssl
          readOnly: true
        {{- end }}
      resources:
        requests:
          memory: "256Mi"
        limits:
          memory: "512Mi"
      livenessProbe:
        httpGet:
          path: /health
          port: 8080
          scheme: HTTP
        initialDelaySeconds: 5
        periodSeconds: 10
        timeoutSeconds: 5
        failureThreshold: 3
  volumes:
    - name: caddy-data
      persistentVolumeClaim:
        claimName: "caddy-worker"
    - name: worker-tls
      persistentVolumeClaim:
        claimName: "worker-tls"
    - name: worker-mtls-encryption-secret
      secret:
        secretName: worker-mtls-encryption-secret
    {{- if and .Values.caddy.sslCertContent .Values.caddy.sslKeyContent }}
    - name: caddy-certs
      secret:
        secretName: caddy-cert-secret
    {{- end }}
