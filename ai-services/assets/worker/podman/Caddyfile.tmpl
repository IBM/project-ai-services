{
	admin 0.0.0.0:2019

	servers :443 {
		name ai_services
	}

	servers :9443 {
		name private_mtls_ingress
	}

	servers :8080 {
		name private_mtls_egress
	}
}

:443 {
	# Seed the routes array so it is never empty at startup.
	handle /internal/health {
		# @id internal-health
		respond "OK" 200
	}

	tls internal
}

# Private ingress for service-to-service traffic (mTLS enforced).
# Serves the worker certificate and trusts only client certificates signed by the
# platform CA. tls.key is AES-GCM encrypted; the encrypted_file module decrypts it
# in memory on each handshake, so no plaintext key is ever written to disk. The
# files are written by the worker once it has registered with the control plane;
# until then handshakes on this port fail and then succeed with no Caddy reload.
:9443 {
	handle /internal/health {
		# @id internal-private-health
		respond "OK" 200
	}

	tls {
		get_certificate encrypted_file {
			cert        /data/worker-tls/tls.crt
			key         /data/worker-tls/tls.key
			secret_file /etc/secret/worker-mtls-encryption-secret/mtls-encryption-key
		}
		client_auth {
			mode require_and_verify
			trusted_ca_cert_file /data/worker-tls/ca.crt
		}
	}
}

# Internal health check endpoint used by the liveness probe and private egress (plain HTTP).
:8080 {
	respond /health "OK" 200
}

# Routes for deployed service pods are registered dynamically by the worker daemon
# via the Caddy Admin API after each successful pod deployment.
