{
	admin 0.0.0.0:2019

	servers :443 {
		name ai_services
	}
}

:443 {
	# Seed the routes array so it is never empty at startup.
	handle /internal/health {
		# @id internal-health
		respond "OK" 200
	}

	tls internal
}

# Internal health check endpoint used by the liveness probe (plain HTTP).
:8080 {
	respond /health "OK" 200
}

# Routes for deployed service pods are registered dynamically by the worker daemon
# via the Caddy Admin API after each successful pod deployment.
