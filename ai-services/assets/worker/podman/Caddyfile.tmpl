{
	admin 0.0.0.0:2019

	servers :443 {
		name ai_services
	}
}

:443 {
	# Seed the routes array so it is never empty at startup.
	handle /internal/health {
		# @id internal-health
		respond "OK" 200
	}

	tls internal
}

# Private ingress for service-to-service traffic (mTLS enforced).
# Serves the worker certificate and trusts only client certificates signed by the
# platform CA. tls.key.pem is the plaintext copy of the encrypted tls.key, written
# by the worker process once it has registered with the control plane.
:9443 {
	handle /internal/health {
		# @id internal-private-health
		respond "OK" 200
	}

	tls /data/worker-tls/tls.crt /data/worker-tls/tls.key.pem {
		client_auth {
			mode require_and_verify
			trusted_ca_cert_file /data/worker-tls/ca.crt
		}
	}
}

# Internal health check endpoint used by the liveness probe and private egress (plain HTTP).
:8080 {
	respond /health "OK" 200
}

# Routes for deployed service pods are registered dynamically by the worker daemon
# via the Caddy Admin API after each successful pod deployment.
