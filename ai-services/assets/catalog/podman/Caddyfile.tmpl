{
	admin 0.0.0.0:2019

	servers :443 {
		name {{ .CaddyServerName }}
	}

	servers :9443 {
		name private_mtls_ingress
	}

	servers :8080 {
		name private_mtls_egress
	}
}

:443 {
	# 1. This initializes the routes array natively so it's never empty
	handle /internal/health {
		# @id internal-health
		respond "OK" 200
	}

	tls internal
}

# Private ingress for service-to-service traffic (mTLS enforced).
# Serves the gateway server certificate and trusts only client certificates signed
# by the platform CA. server.key.pem is the plaintext copy of the encrypted
# server.key, written by the catalog process before this pod starts.
:9443 {
	handle /internal/health {
		# @id internal-private-health
		respond "OK" 200
	}

	tls /data/gateway-pki/server.crt /data/gateway-pki/server.key.pem {
		client_auth {
			mode require_and_verify
			trusted_ca_cert_file /data/gateway-pki/ca.crt
		}
	}
}

# Internal health check endpoint and private egress (Bypasses automatic HTTPS redirection)
:8080 {
	respond /health "OK" 200
}

# This file serves as the base configuration
# Routes will be dynamically added via Caddy Admin API
