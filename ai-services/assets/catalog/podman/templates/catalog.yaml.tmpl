apiVersion: v1
kind: Pod
metadata:
  name: "{{ .AppName }}--catalog"
  labels:
    ai-services.io/application: "{{ .AppName }}"
    ai-services.io/template: "{{ .AppTemplateName }}"
    ai-services.io/component: "catalog"
    ai-services.io/version: "{{ .Version }}"
    ai-services.io/secret: "catalog-secret,catalog-db-encryption-secret,catalog-mtls-encryption-secret,podman-auth-secret"
    ai-services.io/secret-skip-cleanup: "true"
    ai-services.io/volume: "podman-auth-secret,catalog-secret,catalog-db-encryption-secret,catalog-mtls-encryption-secret,catalog-bundles,catalog-caddy-cert-secret,gateway-pki"
    ai-services.io/volume-skip-cleanup: "true"
  annotations:
    ai-services.io/routes: "8081:catalog-ui:ui, 8080:catalog-api:api"
    # ai-services.io/ports: "{{ .Values.ui.port }}:8081, {{ .Values.backend.port }}:8080"  # Uncomment to expose ports directly (bypasses Caddy)
spec:
  restartPolicy: always
  initContainers:
    - name: db-migration
      image: "{{ .Values.backend.image }}"
      command: ["/bin/sh", "-c"]
      args:
        - |
          set -e
          export DB_PASSWORD=$(cat /etc/secret/catalog-db-secret/db-password)

          max_retries=5
          retry_delay=5

          echo "Running database migrations with retry logic..."
          for attempt in $(seq 1 $max_retries); do
            echo "Migration attempt $attempt of $max_retries..."

            if /usr/bin/ai-services catalog dbmigrate init \
              --db-host={{ .AppName }}--db \
              --db-port=5432 \
              --db-user={{ .Values.db.user }} \
              --db-password="${DB_PASSWORD}" \
              --db-name={{ .Values.db.database }} \
              --db-sslmode=disable; then
              echo "Migrations completed successfully"
              exit 0
            fi

            if [ $attempt -lt $max_retries ]; then
              echo "Migration failed, retrying in ${retry_delay} seconds..."
              sleep $retry_delay
            else
              echo "ERROR: Migration failed after $max_retries attempts"
              exit 1
            fi
          done
      resources:
        requests:
          memory: "512Mi"
        limits:
          memory: "512Mi"
      volumeMounts:
        - name: catalog-db-secret
          mountPath: /etc/secret/catalog-db-secret
          readOnly: true
  containers:
    - name: ui
      image: "{{ .Values.ui.image }}"
      resources:
        requests:
          memory: "512Mi"
        limits:
          memory: "512Mi"
      env:
        - name: BACKEND_HOST
          value: "{{ .AppName }}--catalog"
        - name: BACKEND_PORT
          value: "8080"
      ports:
        - containerPort: 8081
          protocol: TCP
      livenessProbe:
        httpGet:
          path: /
          port: 8081
        initialDelaySeconds: 10
        periodSeconds: 30
        timeoutSeconds: 5
        failureThreshold: 3
    - name: backend
      image: "{{ .Values.backend.image }}"
      command: ["/bin/sh", "-c"]
      args:
        - |
          export ADMIN_PASSWORD=$(cat /etc/secret/catalog-secret/admin-password)
          export DB_PASSWORD=$(cat /etc/secret/catalog-db-secret/db-password)
          export DB_ENCRYPTION_KEY=$(cat /etc/secret/catalog-db-encryption-secret/db-encryption-key)
          export MTLS_ENCRYPTION_KEY=$(cat /etc/secret/catalog-mtls-encryption-secret/mtls-encryption-key)
          exec /usr/bin/ai-services catalog apiserver --port=8080 --admin-username=admin --admin-password-hash=${ADMIN_PASSWORD} --runtime={{ .Values.backend.runtime }} --workergateway-port={{ .Values.backend.workerGatewayPort }}
      env:
        - name: GIN_MODE
          value: "release"
        - name: AI_SERVICES_LOG_LEVEL
          value: "info"
        - name: AI_SERVICES_LOG_FORMAT
          value: "service"
        - name: REGISTRY_AUTH_FILE
          value: "/run/containers/auth.json"
        - name: DB_HOST
          value: {{ .AppName }}--db
        - name: DB_PORT
          value: "5432"
        - name: DB_USER
          value: "{{ .Values.db.user }}"
        - name: AI_SERVICES_BASE_DIR
          value: "{{ .BaseDir }}"
        - name: CADDY_ADMIN_URL
          value: "{{ .CaddyAdminURL }}"
        - name: CADDY_HTTPS_PORT
          value: "{{ .Values.caddy.httpsPort }}"
        - name: CADDY_PRIVATE_INGRESS_PORT
          value: "{{ .Values.caddy.privateIngressPort }}"
        - name: DOMAIN_SUFFIX
          value: "{{ .DomainSuffix }}"
        - name: WORKER_GATEWAY_PORT
          value: "{{ .Values.backend.workerGatewayPort }}"
        - name: LOCAL_WORKER
          value: "{{ .Values.backend.localWorker }}"
        # LiteLLM runs in its own pod; the catalog backend registers model routes through it.
        - name: LITELLM_ENDPOINT
          value: "http://{{ .AppName }}--litellm:{{ .Values.litellm.port }}"
      ports:
        - containerPort: 8080
          protocol: TCP
        - containerPort: {{ .Values.backend.workerGatewayPort }}
          hostPort: {{ .Values.backend.workerGatewayPort }}
          protocol: TCP
      livenessProbe:
        httpGet:
          path: /health
          port: 8080
        initialDelaySeconds: 10
        periodSeconds: 30
        timeoutSeconds: 5
        failureThreshold: 3
      volumeMounts:
        - name: podman-auth
          mountPath: /run/containers/auth.json
          subPath: auth.json
          readOnly: true
        - name: ai-services-data
          mountPath: {{ .BaseDir }}
        - name: gateway-pki
          mountPath: /data/gateway-pki
        - name: catalog-secret
          mountPath: /etc/secret/catalog-secret
          readOnly: true
        - name: catalog-db-secret
          mountPath: /etc/secret/catalog-db-secret
          readOnly: true
        - name: catalog-db-encryption-secret
          mountPath: /etc/secret/catalog-db-encryption-secret
          readOnly: true
        - name: catalog-mtls-encryption-secret
          mountPath: /etc/secret/catalog-mtls-encryption-secret
          readOnly: true
        # The LiteLLM client reads the master key from /etc/secret/litellm-secret/master-key.
        - name: litellm-secret
          mountPath: /etc/secret/litellm-secret
          readOnly: true
        - name: catalog-bundles
          mountPath: /data/catalog-bundles
      resources:
        requests:
          memory: "1Gi"
        limits:
          memory: "1Gi"
  volumes:
    - name: podman-auth
      secret:
        secretName: podman-auth-secret
    - name: ai-services-data
      hostPath:
        path: {{ .BaseDir }}
        type: DirectoryOrCreate
    - name: catalog-secret
      secret:
        secretName: catalog-secret
    - name: catalog-db-secret
      secret:
        secretName: catalog-db-secret
    - name: catalog-db-encryption-secret
      secret:
        secretName: catalog-db-encryption-secret
    - name: catalog-mtls-encryption-secret
      secret:
        secretName: catalog-mtls-encryption-secret
    - name: litellm-secret
      secret:
        secretName: litellm-secret
    - name: catalog-bundles
      persistentVolumeClaim:
        claimName: catalog-bundles
    - name: gateway-pki
      persistentVolumeClaim:
        claimName: gateway-pki
