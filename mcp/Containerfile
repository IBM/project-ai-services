# ============================================================================
# Build Stage
# ============================================================================
FROM registry.access.redhat.com/ubi9/ubi:9.8 AS builder

ARG GO_VERSION=1.26.10

WORKDIR /go/src/github.com/project-ai-services/mcp

USER root

RUN curl -fsSL https://go.dev/dl/go${GO_VERSION}.linux-ppc64le.tar.gz -o go.tar.gz && \
    tar -C /usr/local -xzf go.tar.gz && \
    rm go.tar.gz

ENV PATH="/usr/local/go/bin:${PATH}"

COPY go.mod go.sum ./
RUN go mod download && go mod verify

COPY . .

RUN CGO_ENABLED=0 go build -ldflags="-s -w" \
    -o bin/ai-services-mcp \
    ./cmd/ai-services-mcp/main.go

# ============================================================================
# Runtime Stage
# ============================================================================
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8

# Image provenance labels (populated via --build-arg, see hack/image-labels.mk)
ARG GIT_REPO=https://github.com/ibm/project-ai-services
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown
LABEL org.opencontainers.image.source="${GIT_REPO}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.title="AI Services MCP Server" \
      org.opencontainers.image.vendor="IBM" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.description="AI Services MCP server" \
      com.github.project-ai-services.containerfile="mcp/Containerfile" \
      com.github.project-ai-services.containerfile.url="${GIT_REPO}/blob/${GIT_COMMIT}/mcp/Containerfile"

COPY --from=builder /go/src/github.com/project-ai-services/mcp/bin/ai-services-mcp /usr/bin/ai-services-mcp

USER 1001

ENTRYPOINT ["/usr/bin/ai-services-mcp"]
CMD ["--help"]
